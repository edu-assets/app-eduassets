# Public build-time settings only; never place secrets in VITE_* variables.
# An empty API base uses the Vite proxy locally.
VITE_API_BASE_URL=
VITE_RFID_BRIDGE_ENABLED=false
# Docs are fetched from an immutable commit pinned in src/core/docs/docsService.ts.
# Bundled /docs files are the fallback; no docs-base override is supported.
